// JKR International — Medical Equipment E-Commerce Platform
// Prisma schema (PostgreSQL — Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  password  String
  firstName String?
  lastName  String?
  role      String   @default("customer") // customer | admin | staff
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]
  enquiries  Enquiry[]
  reviews    ProductReview[]
  addresses  Address[]
  cartItems  CartItem[]
  storeMemberships StoreMember[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  emirate   String?
  country   String  @default("UAE")
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameAr    String?
  imageUrl  String?
  icon      String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoUrl     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]
}

model Collection {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameAr        String?
  bannerImageUrl String?
  description   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  products CollectionProduct[]
}

model CollectionProduct {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  nameAr           String?
  description      String?
  descriptionAr    String?
  shortDescription String?
  specifications   String? // JSON string of key-value pairs
  sku              String?
  barcode          String?
  regularPrice     Float
  salePrice        Float?
  onSale           Boolean  @default(false)
  stockQty         Int      @default(0)
  inStock          Boolean  @default(true)
  categoryId       String?
  brandId          String?
  isFeatured       Boolean  @default(false)
  isExclusive      Boolean  @default(false)
  badge            String?  // e.g. 'New', 'Best Seller', 'blue', 'dark'
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  ratingAvg        Float    @default(0)
  ratingCount      Int      @default(0)
  attributes       String   @default("{}") // JSON: ProductField.slug → value (custom catalogue fields)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  reviews     ProductReview[]
  collections CollectionProduct[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([onSale])
  @@index([isFeatured])
  @@index([isExclusive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  rating     Int
  reviewText String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model CartItem {
  id        String @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  quantity  Int    @default(1)
  notes     String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model WishlistItem {
  id        String @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model Enquiry {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  customerName  String
  email      String
  phone      String?
  company    String?
  message    String?
  status     String   @default("new") // new | contacted | quoted | closed
  itemsJson  String   // JSON snapshot of items
  total      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  userId          String?
  customerName    String
  email           String
  phone           String?
  billingAddress  String   // JSON
  shippingAddress String   // JSON
  subtotal        Float    @default(0)
  discount        Float    @default(0)
  total           Float    @default(0)
  paymentMethod   String   @default("cod") // tabby | tamara | network | cod
  paymentStatus   String   @default("pending") // pending | paid | failed | refunded
  orderStatus     String   @default("pending") // pending | confirmed | shipped | delivered | cancelled
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([orderStatus])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  sku         String?
  unitPrice   Float
  qty         Int
  subtotal    Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model BlogPost {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  titleAr        String?
  excerpt        String?
  content        String
  contentAr      String?
  category       String   @default("General")
  tags           String?
  authorName     String   @default("JKR Editorial")
  coverImageUrl  String?
  isPublished    Boolean  @default(true)
  publishedAt    DateTime @default(now())
  metaTitle      String?
  metaDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String?
  avatarUrl String?
  content   String
  rating    Int     @default(5)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model ClientLogo {
  id         String  @id @default(cuid())
  name       String
  logoUrl    String?
  websiteUrl String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
}

model HeroSlide {
  id        String  @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  ctaLabel  String?
  ctaUrl    String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model GalleryItem {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String?
  category  String  @default("General")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model SiteSettings {
  key   String @id
  value String
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  isActive    Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

// ---------- Online store: themes, custom pages, navigation ----------

// An installed theme. Exactly one row has isActive=true (enforced in the install/activate routes).
// kind: 'native' (theme.json package) | 'html' (imported static HTML template).
model Theme {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  version        String   @default("1.0.0")
  author         String?
  description    String?
  kind           String   @default("native")
  isActive       Boolean  @default(false)
  settingsSchema String   @default("[]") // JSON: ThemeSettingDef[]
  settings       String   @default("{}") // JSON: values keyed by setting id
  sections       String   @default("[]") // JSON: homepage ThemeSection[]
  css            String   @default("")
  // Unpublished edits (JSON ThemeDoc: settings, sections, css). The columns above are what the store shows.
  draft          String?
  // Bumped on every draft save and publish; writes carry the revision they started from (optimistic locking).
  revision       Int      @default(0)
  report         String   @default("{}") // JSON: ThemeReport from install (adapter, compatibility level, warnings)
  sourceUrl      String?  // untouched copy of the uploaded zip
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pages     Page[]
  revisions ThemeRevision[]

  @@index([isActive])
}

// Snapshot of a theme's live settings/sections/CSS, recorded on every publish and rollback.
model ThemeRevision {
  id        String   @id @default(cuid())
  themeId   String
  number    Int
  note      String   @default("")
  author    String?
  settings  String
  sections  String
  css       String
  createdAt DateTime @default(now())

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, number])
}

// Custom content page. Pages imported with a theme are removed with it; admin-created pages have no theme.
// layout: 'standard' (inside the store, sanitized HTML) | 'isolated' (sandboxed frame with its own CSS).
model Page {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  content          String   @default("")
  css              String   @default("")
  bodyClass        String   @default("") // class on <body> for isolated pages (imported templates)
  layout           String   @default("standard")
  hideHeaderFooter Boolean  @default(false)
  isPublished      Boolean  @default(true)
  metaTitle        String?
  metaDescription  String?
  themeId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  theme Theme? @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
}

// Navigation menu ('main' = header, 'footer' = footer columns). itemsJson: MenuItem[] (two levels).
model Menu {
  id        String   @id @default(cuid())
  handle    String   @unique
  name      String
  itemsJson String   @default("[]")
  updatedAt DateTime @updatedAt
}

// Custom product field, created by hand or automatically when an imported catalogue has a column
// the store doesn't know. Values live in Product.attributes under this slug; empty values are hidden.
model ProductField {
  id               String   @id @default(cuid())
  slug             String   @unique
  label            String
  sortOrder        Int      @default(0)
  showOnStorefront Boolean  @default(true)
  createdAt        DateTime @default(now())
}

// ---------- Stores (tenants) ----------

// Where a store's storefront design comes from: Figma imports (default for new stores) or the theme system.
enum DesignSource {
  FIGMA
  THEME
}

// A tenant. Existing data belongs to the 'legacy' store (created by migration 1_store); requests whose host
// matches no store domain resolve to it.
model Store {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  domain        String?      @unique // hostname without port, lowercase
  designSource  DesignSource @default(FIGMA)
  // Per-store override of the FEATURE_THEMES env flag; null follows the global flag.
  themesEnabled Boolean?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  members          StoreMember[]
  figmaConnection  FigmaConnection?
  figmaOAuthStates FigmaOAuthState[]
  auditLogs        AuditLog[]
  figmaFiles       FigmaFile[]
  designImports    DesignImport[]
  sectionMappings  SectionMapping[]
  designSystems    DesignSystem[]
  fonts            Font[]
  assets           Asset[]
  pages            StorePage[]
  pageVersions     StorePageVersion[]
}

// Store-scoped tables below carry storeId and are protected twice: storeDb() (src/backend/lib/tenancy.ts)
// injects storeId into every query, and Postgres row level security (migration 2_figma_connection) hides rows
// of other stores unless app.store_id is set to the row's store.

enum StoreRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// A user's role in a store. OWNER/ADMIN manage connections; EDITOR imports and edits designs; VIEWER reads.
model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole @default(VIEWER)
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

enum FigmaAuthType {
  OAUTH
  PAT
}

enum FigmaConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
}

// The store's Figma account. Tokens are envelope-encrypted (src/backend/lib/figma/crypto.ts) with the key
// version in keyVersion; they never leave the server.
model FigmaConnection {
  id              String                @id @default(cuid())
  storeId         String                @unique
  figmaUserId     String
  handle          String
  email           String?
  authType        FigmaAuthType
  accessTokenEnc  String
  refreshTokenEnc String?
  keyVersion      Int
  expiresAt       DateTime? // null for personal access tokens (expiry unknown to the API)
  scopes          String                @default("")
  status          FigmaConnectionStatus @default(ACTIVE)
  createdBy       String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  files FigmaFile[]
}

// Pending OAuth authorization: single-use, 10-minute TTL, bound to store + user + session.
// id is the SHA-256 of the state sent to Figma, so a database read cannot replay a flow.
model FigmaOAuthState {
  id           String   @id
  storeId      String
  userId       String
  sessionHash  String
  codeVerifier String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String
  actorId    String?
  action     String // e.g. figma.connect, figma.disconnect, figma.reauth_required
  entityType String
  entityId   String?
  diff       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

// A Figma file (or branch) a store has imported from. fileKey is the main file; branchKey is "" for the main file.
model FigmaFile {
  id           String   @id @default(cuid())
  storeId      String
  connectionId String?
  fileKey      String
  branchKey    String   @default("")
  name         String
  version      String
  lastModified DateTime
  // Re-sync: Figma webhook (v2) for this file, its passcode (SHA-256) and the newest version seen remotely.
  webhookId           String?
  webhookPasscodeHash String?
  latestVersion       String?
  lastCheckedAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection FigmaConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  imports    DesignImport[]

  @@unique([storeId, fileKey, branchKey])
}

enum DesignImportStatus {
  QUEUED
  FETCHING
  NORMALIZING
  TOKENS
  MAPPING
  ASSETS
  REVIEW
  INSTALLED
  FAILED
}

// One import of selected frames. pageAssignments holds the validated ImportPlan pages (src/shared/design-plan.ts).
model DesignImport {
  id              String             @id @default(cuid())
  storeId         String
  fileId          String
  figmaVersion    String
  status          DesignImportStatus @default(QUEUED)
  selectedNodeIds String[]
  pageAssignments Json
  error           String?
  // Pipeline output (src/backend/lib/design-import/pipeline.ts): snapshots in storage, review data in `result`.
  kind            DesignImportKind   @default(INSTALL)
  rawSnapshotKey  String?
  irSnapshotKey   String?
  warnings        Json               @default("[]")
  stats           Json               @default("{}")
  result          Json?
  // Job queue: claimed rows get lockedAt; failed stages retry after runAfter until attempts runs out.
  attempts        Int                @default(0)
  lockedAt        DateTime?
  runAfter        DateTime           @default(now())
  installedAt     DateTime?
  createdBy       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  store Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  file  FigmaFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([fileId])
  @@index([status, runAfter])
}

enum DesignImportKind {
  INSTALL
  RESYNC
}

// Section type and layer→field choices an admin made in review, reused when the same Figma node is imported again.
model SectionMapping {
  id          String   @id @default(cuid())
  storeId     String
  fileKey     String
  nodeId      String
  sectionType String
  fieldMap    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fileKey, nodeId])
}

enum DesignSystemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Design tokens (src/shared/design-tokens.ts). One ACTIVE row per store drives the storefront's CSS variables.
model DesignSystem {
  id        String             @id @default(cuid())
  storeId   String
  importId  String?
  version   Int
  status    DesignSystemStatus @default(DRAFT)
  tokens    Json
  createdBy String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, version])
  @@index([storeId, status])
}

enum FontSource {
  GOOGLE
  UPLOAD
}

// Self-hosted font files. files: { weight, style, url, format }[].
model Font {
  id        String     @id @default(cuid())
  storeId   String
  family    String
  weights   Int[]
  source    FontSource
  files     Json       @default("[]")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, family])
}

// Image or SVG copied out of Figma (or uploaded), deduplicated per store by content hash.
model Asset {
  id           String   @id @default(cuid())
  storeId      String
  hash         String
  sourceNodeId String?
  storageKey   String
  url          String
  mime         String
  width        Int
  height       Int
  variants     Json     @default("[]")
  alt          String   @default("")
  altReviewed  Boolean  @default(false)
  blurhash     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, hash])
}

// Store page built from sections. HEADER/FOOTER/ANNOUNCEMENT are global sections (reserved slugs _header, _footer,
// _announcement) shown on every page.
enum StorePageType {
  HOME
  PAGE
  PRODUCT_TEMPLATE
  COLLECTION_TEMPLATE
  CART
  HEADER
  FOOTER
  ANNOUNCEMENT
}

model StorePage {
  id                 String        @id @default(cuid())
  storeId            String
  type               StorePageType
  slug               String
  title              String
  seo                Json          @default("{}")
  publishedVersionId String?       @unique
  sourceFileId       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  versions         StorePageVersion[] @relation("PageVersions")
  publishedVersion StorePageVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@unique([storeId, slug])
}

enum PageVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Immutable once published. At most one DRAFT per page; `revision` guards concurrent draft saves.
model StorePageVersion {
  id             String            @id @default(cuid())
  storeId        String
  pageId         String
  version        Int
  sections       Json
  status         PageVersionStatus @default(DRAFT)
  revision       Int               @default(0)
  sourceImportId String?
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  publishedAt    DateTime?

  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  page        StorePage  @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  publishedOf StorePage? @relation("PublishedVersion")

  @@unique([pageId, version])
  @@index([storeId])
}
