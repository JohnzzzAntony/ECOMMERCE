# ============================================================
# JKR International — Environment Configuration
# ============================================================

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (Payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CURRENCY=AED

# Feature flags
# Theme system (theme library, customizer, theme admin API). Off unless "true".
# A store can override this with Store.themesEnabled (true/false); null follows this flag.
FEATURE_THEMES=false

# Figma integration (see docs/figma-integration/FIGMA-APP-SETUP.md)
# OAuth app credentials from https://www.figma.com/developers/apps. Leave empty to allow only personal access tokens.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the Figma app.
FIGMA_REDIRECT_URI=https://your-store.example/api/design/figma/oauth/callback
# Token encryption keys, "<version>:<base64 of 32 random bytes>", comma separated; the highest version encrypts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIGMA_TOKEN_KEYS=

# Tests only: a disposable, migrated Postgres for row level security tests (never production).
TEST_DATABASE_URL=

# Store resolution: stores without a custom domain are served at <store-slug>.<PLATFORM_DOMAIN>.
PLATFORM_DOMAIN=

# Design imports
# Web store URL; when it is https, Figma webhooks notify NexEcoms of new file versions (otherwise polling is used).
# (NEXT_PUBLIC_SITE_URL above)
# Development only: DESIGN_STORAGE=local stores design assets under .design-storage/ instead of Cloudinary.
DESIGN_STORAGE=
# Development/E2E only (ignored in production): FIGMA_API_BASE, FIGMA_OAUTH_URL, FIGMA_TEST_ASSET_ORIGIN point the
# app at the mock Figma in e2e/mock-figma.ts.

# AI section generator (admin page editor → "Generate with AI"): any OpenAI-compatible chat completions API with
# image input. Defaults: NVIDIA NIM, nvidia/nemotron-3.5-super-vl-120b-a12b. Leave the key empty to disable.
AI_DESIGN_BASE_URL=https://integrate.api.nvidia.com/v1
AI_DESIGN_API_KEY=
AI_DESIGN_MODEL=
